{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Unplug players as AFK",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/${mod_id}",
    "sources": "https://github.com/${mod_author}/${mod_id}",
    "issues": "https://github.com/${mod_author}/${mod_id}/issues"
  },
  "license": "LGPL-3.0",

  "icon": "assets/unplugged_afk/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sakuraryoko.unplugged_afk.impl.UnpluggedAfk"
    ]
  },
  "mixins": [
    "unplugged_afk.mixins.json"
  ],
  "accessWidener": "unplugged_afk.accesswidener",

  "depends": {
    "fabricloader": ">=0.11.4",
    "core-lib-api": "*",
    "minecraft": "${minecraft_dependency}"
  },

  "custom": {
    "modmenu": {
      "parent":{
        "id": "core-lib-api",
        "name": "Core Lib API",
        "description": "Core Library API",
        "badges": [ "library" ]
      }
    }
  }
}
